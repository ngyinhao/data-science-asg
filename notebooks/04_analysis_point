   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# Load dataset\n",
    "df = pd.read_csv(\"../data/raw/SeoulBikeData.csv\", encoding=\"latin1\")\n",
    "\n",
    "# Calculate mean and median bike counts per hour\n",
    "hourly_stats = (\n",
    "    df.groupby(\"Hour\")[\"Rented Bike Count\"]\n",
    "    .agg([\"mean\", \"median\"])\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# Retrieve key points dynamically\n",
    "morning_peak = hourly_stats.loc[hourly_stats[\"Hour\"] == 8].iloc[0]\n",
    "evening_peak = hourly_stats.loc[hourly_stats[\"Hour\"] == 18].iloc[0]\n",
    "min_demand = hourly_stats.loc[hourly_stats[\"mean\"].idxmin()]\n",
    "\n",
    "# Visual styling configuration\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "# Plot mean and median hourly demand\n",
    "plt.plot(\n",
    "    hourly_stats[\"Hour\"],\n",
    "    hourly_stats[\"mean\"],\n",
    "    marker=\"o\",\n",
    "    linewidth=2.5,\n",
    "    color=\"#1f77b4\",\n",
    "    label=\"Mean Rental Count\",\n",
    ")\n",
    "plt.plot(\n",
    "    hourly_stats[\"Hour\"],\n",
    "    hourly_stats[\"median\"],\n",
    "    marker=\"s\",\n",
    "    linestyle=\"--\",\n",
    "    linewidth=1.8,\n",
    "    color=\"#ff7f0e\",\n",
    "    label=\"Median Rental Count\",\n",
    ")\n",
    "\n",
    "# Highlight discrete hourly peak intervals\n",
    "# Hour 8 (8:00 AM - 9:00 AM) and Hours 18-20 (6:00 PM - 9:00 PM)\n",
    "plt.axvspan(7.5, 8.5, color=\"green\", alpha=0.15, label=\"Morning Peak (08:00 AM)\")\n",
    "plt.axvspan(17.5, 18.5, color=\"red\", alpha=0.15, label=\"Evening Peak (06:00 PM)\")\n",
    "\n",
    "# Dynamic Y-axis scale (18% headroom above max mean)\n",
    "max_mean_val = hourly_stats[\"mean\"].max()\n",
    "plt.ylim(0, max_mean_val * 1.18)\n",
    "\n",
    "# Annotate Morning Peak, Evening Peak, and Nighttime Minimum\n",
    "plt.text(\n",
    "    morning_peak[\"Hour\"],\n",
    "    morning_peak[\"mean\"] + 45,\n",
    "    f\"{morning_peak['mean']:.0f}\",\n",
    "    ha=\"center\",\n",
    "    va=\"bottom\",\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\",\n",
    "    color=\"#1f77b4\",\n",
    ")\n",
    "\n",
    "plt.text(\n",
    "    evening_peak[\"Hour\"],\n",
    "    evening_peak[\"mean\"] + 45,\n",
    "    f\"{evening_peak['mean']:.0f}\",\n",
    "    ha=\"center\",\n",
    "    va=\"bottom\",\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\",\n",
    "    color=\"#1f77b4\",\n",
    ")\n",
    "\n",
    "plt.text(\n",
    "    min_demand[\"Hour\"],\n",
    "    min_demand[\"mean\"] + 45,\n",
    "    f\"{min_demand['mean']:.0f}\",\n",
    "    ha=\"center\",\n",
    "    va=\"bottom\",\n",
    "    fontsize=10,\n",
    "    fontweight=\"bold\",\n",
    "    color=\"#d62728\",\n",
    ")\n",
    "\n",
    "# Chart labels and layout adjustments\n",
    "plt.title(\n",
    "    \"Hourly Bike Rental Demand Trends\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\",\n",
    "    pad=15,\n",
    ")\n",
    "plt.xlabel(\"Hour of the Day (0–23)\", fontsize=11)\n",
    "plt.ylabel(\"Average Rented Bike Count\", fontsize=11)\n",
    "plt.xticks(range(0, 24))\n",
    "plt.xlim(-0.5, 23.5)\n",
    "plt.legend(loc=\"upper left\", frameon=True)\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()"
   ]
  },
