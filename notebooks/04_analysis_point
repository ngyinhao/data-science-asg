   ],
   "source": [
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 1. Load data\n",
    "# ------------------------------------------------------------------\n",
    "data_path = Path(\"SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"data/raw/SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"../data/raw/SeoulBikeData.csv\")\n",
    "\n",
    "df = pd.read_csv(data_path, encoding=\"unicode_escape\")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 2. Data quality: Exclude non-functioning days (295 system downtime rows)\n",
    "# ------------------------------------------------------------------\n",
    "df_clean = df[df[\"Functioning Day\"] == \"Yes\"].copy()\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 3. Parse dates and derive DayType\n",
    "# ------------------------------------------------------------------\n",
    "df_clean[\"Date\"] = pd.to_datetime(df_clean[\"Date\"], format=\"%d/%m/%Y\")\n",
    "df_clean[\"DayType\"] = df_clean[\"Date\"].dt.dayofweek.apply(\n",
    "    lambda x: \"Weekend\" if x >= 5 else \"Weekday\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 4. Aggregation (mean, sample count, standard deviation)\n",
    "# ------------------------------------------------------------------\n",
    "hourly_daytype = (\n",
    "    df_clean.groupby([\"Hour\", \"DayType\"])[\"Rented Bike Count\"]\n",
    "    .agg([\"mean\", \"count\", \"std\"])\n",
    "    .reset_index()\n",
    "    .rename(columns={\"mean\": \"Mean\", \"count\": \"N\", \"std\": \"Std\"})\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 5. Robust Peak Extraction\n",
    "# ------------------------------------------------------------------\n",
    "weekday = hourly_daytype[hourly_daytype[\"DayType\"] == \"Weekday\"]\n",
    "weekend = hourly_daytype[hourly_daytype[\"DayType\"] == \"Weekend\"]\n",
    "\n",
    "wk_am_val = weekday.loc[weekday[\"Hour\"] == 8, \"Mean\"].values[0]\n",
    "wk_pm_val = weekday.loc[weekday[\"Hour\"] == 18, \"Mean\"].values[0]\n",
    "we_pm_val = weekend.loc[weekend[\"Hour\"] == 17, \"Mean\"].values[0]\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# 6. Visual styling and rendering\n",
    "# ------------------------------------------------------------------\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "sns.lineplot(\n",
    "    data=hourly_daytype,\n",
    "    x=\"Hour\",\n",
    "    y=\"Mean\",\n",
    "    hue=\"DayType\",\n",
    "    palette={\"Weekday\": \"#1f77b4\", \"Weekend\": \"#ff7f0e\"},\n",
    "    style=\"DayType\",\n",
    "    markers=True,\n",
    "    dashes=False,\n",
    "    linewidth=2.5,\n",
    "    markersize=7,\n",
    "    ax=ax,\n",
    ")\n",
    "\n",
    "# Highlight Discrete Peak Bands\n",
    "ax.axvspan(7.5, 8.5, color=\"#1f77b4\", alpha=0.1)\n",
    "ax.axvspan(17.5, 18.5, color=\"#1f77b4\", alpha=0.15)\n",
    "ax.axvspan(16.5, 17.5, color=\"#ff7f0e\", alpha=0.1)\n",
    "\n",
    "# Annotate Peak Values Above Data Points\n",
    "offset = 50\n",
    "ax.text(8, wk_am_val + offset, f\"{wk_am_val:.0f}\",\n",
    "        ha=\"center\", va=\"bottom\", fontsize=10, fontweight=\"bold\", color=\"#1f77b4\")\n",
    "ax.text(18, wk_pm_val + offset, f\"{wk_pm_val:.0f}\",\n",
    "        ha=\"center\", va=\"bottom\", fontsize=10, fontweight=\"bold\", color=\"#1f77b4\")\n",
    "ax.text(16.5, we_pm_val + offset, f\"{we_pm_val:.0f}\",\n",
    "        ha=\"center\", va=\"bottom\", fontsize=10, fontweight=\"bold\", color=\"#ff7f0e\")\n",
    "\n",
    "# Chart Layout & Axis Configuration\n",
    "ax.set_title(\"Weekday and Weekend Hourly Bike Demand\",\n",
    "             fontsize=13, fontweight=\"bold\", pad=15)\n",
    "ax.set_xlabel(\"Hour of the Day (0–23)\", fontsize=11)\n",
    "ax.set_ylabel(\"Average Rented Bike Count\", fontsize=11)\n",
    "ax.set_xticks(range(0, 24))\n",
    "ax.set_xlim(-0.5, 23.5)\n",
    "ax.set_ylim(0, 2000)\n",
    "ax.legend(title=\"Day Type\", loc=\"upper left\", frameon=True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
