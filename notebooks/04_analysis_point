   "source": [
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# Load dataset\n",
    "data_path = Path(\"SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"data/raw/SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"../data/raw/SeoulBikeData.csv\")\n",
    "\n",
    "df = pd.read_csv(data_path, encoding=\"unicode_escape\")\n",
    "\n",
    "# Exclude system downtime hours (Functioning Day == \"No\")\n",
    "df_clean = df[df[\"Functioning Day\"] == \"Yes\"].copy()\n",
    "\n",
    "# Parse date and derive day type (Weekday vs. Weekend)\n",
    "df_clean[\"Date\"] = pd.to_datetime(df_clean[\"Date\"], format=\"%d/%m/%Y\")\n",
    "df_clean[\"DayType\"] = df_clean[\"Date\"].dt.dayofweek.apply(\n",
    "    lambda x: \"Weekend\" if x >= 5 else \"Weekday\"\n",
    ")\n",
    "\n",
    "# Build four distinct comparison groups\n",
    "groups = {\n",
    "    \"Weekday (No Holiday)\": df_clean[\n",
    "        (df_clean[\"DayType\"] == \"Weekday\")\n",
    "        & (df_clean[\"Holiday\"] == \"No Holiday\")\n",
    "    ],\n",
    "    \"Weekday (Holiday)\": df_clean[\n",
    "        (df_clean[\"DayType\"] == \"Weekday\") & (df_clean[\"Holiday\"] == \"Holiday\")\n",
    "    ],\n",
    "    \"Weekend (No Holiday)\": df_clean[\n",
    "        (df_clean[\"DayType\"] == \"Weekend\")\n",
    "        & (df_clean[\"Holiday\"] == \"No Holiday\")\n",
    "    ],\n",
    "    \"Weekend (Holiday)\": df_clean[\n",
    "        (df_clean[\"DayType\"] == \"Weekend\") & (df_clean[\"Holiday\"] == \"Holiday\")\n",
    "    ],\n",
    "}\n",
    "\n",
    "# Aggregate mean hourly count per group\n",
    "agg_list = []\n",
    "for name, g in groups.items():\n",
    "    stats = (\n",
    "        g.groupby(\"Hour\")[\"Rented Bike Count\"]\n",
    "        .mean()\n",
    "        .reset_index()\n",
    "    )\n",
    "    stats[\"Group\"] = name\n",
    "    agg_list.append(stats)\n",
    "\n",
    "plot_df = pd.concat(agg_list, ignore_index=True)\n",
    "\n",
    "# Visual styling setup\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "palette = {\n",
    "    \"Weekday (No Holiday)\": \"#1f77b4\",\n",
    "    \"Weekday (Holiday)\": \"#d62728\",\n",
    "    \"Weekend (No Holiday)\": \"#ff7f0e\",\n",
    "    \"Weekend (Holiday)\": \"#9467bd\",\n",
    "}\n",
    "\n",
    "# Plot clean hourly curves and annotate peak values\n",
    "for group_name, color in palette.items():\n",
    "    g = plot_df[plot_df[\"Group\"] == group_name]\n",
    "    \n",
    "    # Plot line curve\n",
    "    ax.plot(\n",
    "        g[\"Hour\"],\n",
    "        g[\"Rented Bike Count\"],\n",
    "        marker=\"o\",\n",
    "        label=group_name,\n",
    "        color=color,\n",
    "        linewidth=2.5,\n",
    "        markersize=6,\n",
    "    )\n",
    "    \n",
    "    # For Weekday (No Holiday), annotate BOTH morning (8 AM) and evening (6 PM) peaks\n",
    "    if group_name == \"Weekday (No Holiday)\":\n",
    "        morning_peak = g[g[\"Hour\"] == 8].iloc[0]\n",
    "        evening_peak = g[g[\"Hour\"] == 18].iloc[0]\n",
    "        peaks_to_annotate = [morning_peak, evening_peak]\n",
    "    else:\n",
    "        # For other groups, take the single maximum peak\n",
    "        max_row = g.loc[g[\"Rented Bike Count\"].idxmax()]\n",
    "        peaks_to_annotate = [max_row]\n",
    "    \n",
    "    # Annotate peak values\n",
    "    for peak in peaks_to_annotate:\n",
    "        peak_hour = peak[\"Hour\"]\n",
    "        peak_val = peak[\"Rented Bike Count\"]\n",
    "        \n",
    "        # Position adjustments\n",
    "        if f\"{peak_val:.0f}\" == \"1186\":\n",
    "            offset_x, offset_y = -12, 6\n",
    "            alignment = \"right\"\n",
    "        else:\n",
    "            offset_x, offset_y = 0, 8\n",
    "            alignment = \"center\"\n",
    "            \n",
    "        ax.annotate(\n",
    "            f\"{peak_val:.0f}\",\n",
    "            xy=(peak_hour, peak_val),\n",
    "            xytext=(offset_x, offset_y),\n",
    "            textcoords=\"offset points\",\n",
    "            ha=alignment,\n",
    "            va=\"bottom\",\n",
    "            fontsize=9,\n",
    "            fontweight=\"bold\",\n",
    "            color=color,\n",
    "        )\n",
    "\n",
    "# Formatting chart\n",
    "ax.set_title(\n",
    "    \"Holiday Impact on Hourly Bike Demand\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\",\n",
    "    pad=15,\n",
    ")\n",
    "ax.set_xlabel(\"Hour of the Day (0–23)\", fontsize=11)\n",
    "ax.set_ylabel(\"Average Rented Bike Count\", fontsize=11)\n",
    "ax.set_xticks(range(0, 24))\n",
    "ax.set_xlim(-0.5, 23.5)\n",
    "ax.set_ylim(0, 2050)\n",
    "ax.legend(title=\"Group\", loc=\"upper left\", frameon=True, fontsize=9)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
