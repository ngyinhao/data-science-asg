    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "# Dynamic path resolution for Seoul Bike dataset\n",
    "data_path = Path(\"SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"data/raw/SeoulBikeData.csv\")\n",
    "if not data_path.exists():\n",
    "    data_path = Path(\"../data/raw/SeoulBikeData.csv\")\n",
    "\n",
    "# 1. Load and parse dataset\n",
    "df = pd.read_csv(data_path, encoding=\"latin1\")\n",
    "df[\"Date_parsed\"] = pd.to_datetime(df[\"Date\"], format=\"%d/%m/%Y\")\n",
    "\n",
    "# 2. Build empirical baseline from seasonal, hourly, operating, and holiday averages\n",
    "baseline = (\n",
    "    df.groupby([\"Seasons\", \"Hour\", \"Functioning Day\", \"Holiday\"])[\"Rented Bike Count\"]\n",
    "    .mean()\n",
    "    .reset_index()\n",
    "    .rename(columns={\"Rented Bike Count\": \"Baseline\"})\n",
    ")\n",
    "\n",
    "df = df.merge(\n",
    "    baseline, on=[\"Seasons\", \"Hour\", \"Functioning Day\", \"Holiday\"], how=\"left\"\n",
    ")\n",
    "\n",
    "# Fallback for rare operating combinations\n",
    "missing = df[\"Baseline\"].isna()\n",
    "if missing.sum() > 0:\n",
    "    fallback = (\n",
    "        df.groupby([\"Seasons\", \"Hour\", \"Functioning Day\"])[\"Rented Bike Count\"]\n",
    "        .mean()\n",
    "        .reset_index()\n",
    "        .rename(columns={\"Rented Bike Count\": \"Baseline2\"})\n",
    "    )\n",
    "    df = df.merge(fallback, on=[\"Seasons\", \"Hour\", \"Functioning Day\"], how=\"left\")\n",
    "    df.loc[missing, \"Baseline\"] = df.loc[missing, \"Baseline2\"]\n",
    "\n",
    "# 3. Calculate Demand Residuals (Actual minus Baseline)\n",
    "df[\"Residual\"] = df[\"Rented Bike Count\"] - df[\"Baseline\"]\n",
    "\n",
    "# 4. Flag upper and lower statistical anomalies symmetrically\n",
    "res_std = df[\"Residual\"].std()\n",
    "upper_limit = 2.8 * res_std\n",
    "lower_limit = -2.8 * res_std\n",
    "\n",
    "pos_out = df[df[\"Residual\"] > upper_limit].sort_values(\"Residual\", ascending=False)\n",
    "neg_out = df[df[\"Residual\"] < lower_limit].sort_values(\"Residual\")\n",
    "\n",
    "# 5. Visual Styling Setup\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "# Scatter plot regular observations and anomaly markers\n",
    "ax.scatter(df[\"Date_parsed\"], df[\"Residual\"], alpha=0.15, color=\"#1f77b4\", s=10, label=\"Typical Demand\")\n",
    "ax.scatter(\n",
    "    pos_out[\"Date_parsed\"], pos_out[\"Residual\"],\n",
    "    color=\"#2ca02c\", s=45, zorder=5, edgecolors=\"black\", linewidth=0.5,\n",
    "    label=\"High Demand Anomalies\",\n",
    ")\n",
    "ax.scatter(\n",
    "    neg_out[\"Date_parsed\"], neg_out[\"Residual\"],\n",
    "    color=\"#d62728\", s=45, zorder=5, edgecolors=\"black\", linewidth=0.5,\n",
    "    label=\"Low Demand Anomalies\",\n",
    ")\n",
    "\n",
    "# Boundary and baseline reference lines\n",
    "ax.axhline(upper_limit, color=\"#2ca02c\", linestyle=\"--\", alpha=0.6)\n",
    "ax.axhline(lower_limit, color=\"#d62728\", linestyle=\"--\", alpha=0.6)\n",
    "ax.axhline(0, color=\"black\", linewidth=0.8, alpha=0.5)\n",
    "\n",
    "# Formatting chart labels and axes\n",
    "ax.set_title(\n",
    "    \"Demand Anomaly Detection Relative to Baseline Expectations\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\",\n",
    "    pad=15,\n",
    ")\n",
    "ax.set_xlabel(\"Timeline\", fontsize=11)\n",
    "ax.set_ylabel(\"Demand Difference from Expected Baseline\", fontsize=11)\n",
    "\n",
    "# Extend upper y-axis limit to 2500 to create clear headroom above 1500 for legend\n",
    "ax.set_ylim(bottom=-2500, top=2500)\n",
    "\n",
    "# Position legend in upper left clear space above y = 1500\n",
    "ax.legend(\n",
    "    loc=\"upper left\",\n",
    "    bbox_to_anchor=(0.02, 0.96),\n",
    "    frameon=True,\n",
    "    facecolor=\"white\",\n",
    "    framealpha=0.9,\n",
    "    edgecolor=\"none\",\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
