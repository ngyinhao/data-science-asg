    "counter = np.nan\n",
    "for is_rain in df[\"Is_Raining\"]:\n",
    "    if is_rain:\n",
    "        counter = 0\n",
    "    else:\n",
    "        counter = counter + 1 if not np.isnan(counter) else np.nan\n",
    "    hours_since_rain.append(counter)\n",
    "\n",
    "df[\"Hours_Post_Rain\"] = hours_since_rain\n",
    "df[\"Valid_Lag\"] = df[\"Hours_Post_Rain\"].notna()\n",
    "\n",
    "\n",
    "# 2. Categorize into recovery lag windows\n",
    "def categorize_lag(h):\n",
    "    if pd.isna(h):\n",
    "        return \"No Prior Rain\"\n",
    "    elif h == 0:\n",
    "        return \"Active Rain\"\n",
    "    elif h == 1:\n",
    "        return \"+1 Hr\"\n",
    "    elif h == 2:\n",
    "        return \"+2 Hr\"\n",
    "    elif h == 3:\n",
    "        return \"+3 Hr\"\n",
    "    elif h < 12:\n",
    "        return \"+4–11 Hr\"\n",
    "    else:\n",
    "        return \"Dry Baseline (>=12 Hr)\"\n",
    "\n",
    "\n",
    "df[\"Lag_Category\"] = df[\"Hours_Post_Rain\"].apply(categorize_lag)\n",
    "\n",
    "# Analysis on valid post-rain records only\n",
    "valid_df = df[df[\"Valid_Lag\"]].copy()\n",
